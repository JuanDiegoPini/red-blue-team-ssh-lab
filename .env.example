# Laboratorio Red Team vs Blue Team
# Copia este archivo como .env y configura tu laboratorio.

# IP autorizada del Ubuntu Blue Team
LAB_TARGET_IP=192.168.56.101

# Credenciales exclusivas del laboratorio, en formato JSON.
# El escenario requiere exactamente 10 pares usuario/contrasena.
# No incluyas credenciales reales en este archivo de ejemplo.
LAB_SSH_CREDENTIALS_JSON=[]

# Token privado para acceder a la API
LAB_API_TOKEN=
